{
  "name": "setlist",
  "version": "1.1.0",
  "description": "Setlist - Offline musical reference and service running order tool",
  "author": "William Hay",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "package": "npm run build && electron-builder --mac --dir",
    "package:dmg": "npm run build && electron-builder --mac",
    "test": "npx tsc -p tsconfig.test.json && node --test dist-unit-tests/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.studiosongs.app",
    "productName": "Setlist",
    "mac": {
      "category": "public.app-category.music",
      "target": ["dir"]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
